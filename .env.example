# Names only: copy to .env.local (git-ignored) and paste the values there. Never commit a value.
# Server-only keys: none of these may be NEXT_PUBLIC_.

# The door the Claude models go through (BEDROCK_PROVIDER_1): anthropic (default) or bedrock.
ANTHROPIC_PROVIDER=anthropic
# Used when ANTHROPIC_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Used when ANTHROPIC_PROVIDER=bedrock: a Bedrock API key and the AWS region it was made in (e.g. us-west-1).
BEDROCK_API_KEY=
AWS_REGION=

OPENAI_API_KEY=
FAL_KEY=
