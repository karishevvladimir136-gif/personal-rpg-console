{
  "title": "A job closed: delivery hint, reward paid once, old terms converted",
  "description": "A campaign switched from the previous runtime carries an open quest with old-style reward terms (the carter's lost ledger, which the hero already carries); the switch converts them. The hero takes the best-paid job on the board, does it, and comes back with proof: the DM closes the job and pays its reward once, and pays the converted legacy reward when the ledger is handed over. On dm-loop-v1 only (Stage 4 §2 follow-ups).",
  "runtime": "dm-loop-v1",
  "steps": [
    {
      "id": "meet",
      "say": "I ask the work organiser which notice pays best and who posted it.",
      "expect": [
        {
          "outcome": "committed"
        },
        {
          "npcExists": "organiser"
        }
      ]
    },
    {
      "id": "legacy",
      "action": "legacyQuest",
      "title": "Fetch the carter's lost ledger",
      "description": "Bettany's ledger fell off the cart on the north road.",
      "currencyName": "coins",
      "currencyAmount": 3,
      "issuer": "{{npc:bettany|carter|organiser}}",
      "item": "Bettany's ledger",
      "itemDescription": "A carter's ledger found in a ditch on the north road; the board offers three coins for its return."
    },
    {
      "id": "away",
      "action": "switchRuntime",
      "runtime": "astra-primary-v1"
    },
    {
      "id": "back",
      "action": "switchRuntime",
      "runtime": "dm-loop-v1",
      "expect": [
        {
          "label": "the old reward terms are converted on the switch to the loop",
          "rewardTermsConverted": "ledger"
        }
      ]
    },
    {
      "id": "take",
      "say": "I take that job. Write me down for it and tell me exactly what counts as done.",
      "expect": [
        {
          "outcome": "committed"
        },
        {
          "label": "a job is recorded",
          "questCount": {
            "title": ".",
            "min": 2
          }
        },
        {
          "label": "the job is a quest (not a thread)",
          "questKind": {
            "title": "flour|sack",
            "kind": "quest"
          },
          "scripted": true
        }
      ]
    },
    {
      "id": "work",
      "say": "I set out at once and do the job exactly as posted, carefully, without cutting corners.",
      "expect": [
        {
          "outcome": "committed"
        }
      ]
    },
    {
      "id": "deliver",
      "say": "I come back to the organiser with the proof of the finished job and ask for the pay. I also hand him the carter's ledger from my pack: the board offers three coins for it.",
      "expect": [
        {
          "outcome": "committed"
        },
        {
          "label": "the receipt hinted that the job may be complete",
          "receiptHint": "may complete the open job",
          "scripted": true
        },
        {
          "label": "the flour job is closed",
          "questStatus": {
            "title": "flour|sack",
            "status": "complete"
          },
          "scripted": true
        },
        {
          "label": "a job was closed and its reward settled once",
          "questsSettled": {
            "min": 1
          }
        },
        {
          "label": "the converted legacy reward is paid through the loop",
          "rewardSettled": "ledger"
        },
        {
          "label": "the hero received both rewards",
          "heroMoneyDelta": {
            "min": 8,
            "max": 8
          },
          "scripted": true
        },
        {
          "label": "the hero was paid",
          "heroMoneyDelta": {
            "min": 3
          }
        }
      ]
    },
    {
      "id": "again",
      "say": "I ask the organiser to pay me again for the same job.",
      "expect": [
        {
          "outcome": "committed"
        },
        {
          "label": "a second payment is rejected",
          "rejectedCalls": {
            "min": 1
          },
          "scripted": true
        },
        {
          "label": "no money appeared",
          "heroMoneyDelta": {
            "max": 0
          }
        }
      ]
    }
  ],
  "loop": {
    "meet": {
      "note": "The carter becomes a character; no job yet.",
      "rounds": [
        {
          "text": "The organiser taps the top notice. \"Flour haul for Bettany the carter: twenty sacks to the bakery, five coins. She also lost her ledger on the north road, three coins to whoever brings it back.\"",
          "toolCalls": [
            {
              "name": "upsert_character",
              "arguments": {
                "localKey": "bettany",
                "name": "Bettany the carter",
                "kind": "npc",
                "description": "A carter who works the gate road; posts hauling jobs on the board.",
                "present": false
              }
            },
            {
              "name": "advance_time",
              "arguments": {
                "minutes": 5,
                "reason": "talk at the gate"
              }
            },
            {
              "name": "finish_turn",
              "arguments": {
                "sceneKinds": [
                  "conversation"
                ],
                "spotlight": [
                  "{{npc:organiser}}"
                ],
                "playerMoment": false,
                "nextTension": "calm"
              }
            }
          ]
        }
      ]
    },
    "take": {
      "note": "The second job is a quest with reward terms; the sacks exist in the hero's hands.",
      "rounds": [
        {
          "text": "\"Twenty sacks, five coins, every one dry.\" The organiser makes a mark against your name.",
          "toolCalls": [
            {
              "name": "quest",
              "arguments": {
                "action": "create",
                "localKey": "flour",
                "kind": "quest",
                "title": "Haul the flour sacks",
                "description": "Twenty sacks of flour to the bakery before dusk.",
                "issuerRef": "{{npc:organiser}}",
                "reward": {
                  "currency": "coins",
                  "amount": 5
                }
              }
            },
            {
              "name": "item",
              "arguments": {
                "action": "create",
                "localKey": "sacks",
                "name": "Sack of flour",
                "category": "gear",
                "quantity": 20,
                "ownerRef": "{{hero}}"
              }
            },
            {
              "name": "advance_time",
              "arguments": {
                "minutes": 10,
                "reason": "loading the sacks"
              }
            },
            {
              "name": "finish_turn",
              "arguments": {
                "sceneKinds": [
                  "trade"
                ],
                "spotlight": [
                  "{{npc:organiser}}"
                ],
                "playerMoment": false,
                "nextTension": "calm"
              }
            }
          ]
        }
      ]
    },
    "deliver": {
      "note": "The transfer to the issuer carries the open-job hint; the DM closes both jobs and pays each reward exactly once through claim_reward.",
      "rounds": [
        {
          "text": "The organiser reads the bakery's receipt twice and turns the ledger over in his hands.",
          "toolCalls": [
            {
              "name": "item",
              "arguments": {
                "action": "transfer",
                "itemRef": "Sack of flour",
                "ownerRef": "{{npc:organiser}}"
              }
            },
            {
              "name": "item",
              "arguments": {
                "action": "transfer",
                "itemRef": "Bettany's ledger",
                "ownerRef": "{{npc:organiser}}"
              }
            }
          ]
        },
        {
          "text": " \"Dry, every one. And Bettany's ledger, by the saints.\" He pays out of the board's strongbox without haggling.",
          "toolCalls": [
            {
              "name": "quest",
              "arguments": {
                "action": "complete",
                "questRef": "Haul the flour sacks"
              }
            },
            {
              "name": "quest",
              "arguments": {
                "action": "claim_reward",
                "questRef": "Haul the flour sacks"
              }
            },
            {
              "name": "quest",
              "arguments": {
                "action": "complete",
                "questRef": "Fetch the carter's lost ledger"
              }
            },
            {
              "name": "quest",
              "arguments": {
                "action": "claim_reward",
                "questRef": "Fetch the carter's lost ledger"
              }
            },
            {
              "name": "advance_time",
              "arguments": {
                "minutes": 20,
                "reason": "unloading and settling up"
              }
            },
            {
              "name": "finish_turn",
              "arguments": {
                "sceneKinds": [
                  "trade",
                  "conversation"
                ],
                "spotlight": [
                  "{{npc:organiser}}"
                ],
                "playerMoment": false,
                "nextTension": "calm"
              }
            }
          ]
        }
      ]
    },
    "again": {
      "note": "A second claim is rejected by the server; the DM plays the refusal.",
      "rounds": [
        {
          "text": "The organiser laughs. \"Paid is paid.\"",
          "toolCalls": [
            {
              "name": "quest",
              "arguments": {
                "action": "claim_reward",
                "questRef": "Haul the flour sacks"
              }
            }
          ]
        },
        {
          "text": " She climbs back onto her cart.",
          "toolCalls": [
            {
              "name": "finish_turn",
              "arguments": {
                "sceneKinds": [
                  "conversation",
                  "humor"
                ],
                "spotlight": [
                  "{{npc:organiser}}"
                ],
                "playerMoment": false,
                "nextTension": "calm",
                "npcRefused": true
              }
            }
          ]
        }
      ]
    },
    "work": {
      "note": "The job is done off the board: time passes.",
      "rounds": [
        {
          "text": "You haul the sacks up the hill and back, twenty times, every one dry.",
          "toolCalls": [
            {
              "name": "advance_time",
              "arguments": {
                "minutes": 180,
                "reason": "hauling the sacks"
              }
            },
            {
              "name": "finish_turn",
              "arguments": {
                "sceneKinds": [
                  "exploration"
                ],
                "spotlight": [],
                "playerMoment": false,
                "nextTension": "calm"
              }
            }
          ]
        }
      ]
    }
  }
}