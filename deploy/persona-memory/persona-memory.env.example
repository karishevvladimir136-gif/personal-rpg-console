# Persona memory — the server's settings on a small VPS. This file holds the token: it belongs to root and only root
# can read it. Install it with:
#   sudo install -m 600 -o root -g root persona-memory.env /etc/persona-memory.env
# Fill in the two values marked «<…>» first. Never commit this file or paste it into a chat.

# The token: make it on your PC (docs/PERSONA_MEMORY.md, «For the claude.ai Project») and paste it here.
PERSONA_MEMORY_TOKEN=<paste the token here>
# Your own time zone, as an IANA name (Europe/Moscow, Europe/Berlin, Asia/Almaty …). The server's own zone is UTC.
PERSONA_MEMORY_TIMEZONE=<your zone, e.g. Europe/Berlin>
# Where the store lives (the backup timer packs this folder).
PERSONA_MEMORY_DIR=/var/lib/persona-memory
# Only if the claude.ai dialog has no «Request headers» section: the token then also works as the address's last part
# (https://<name>/mcp/<token>). Read the risk in the guide first.
# PERSONA_MEMORY_PATH_TOKEN=1
